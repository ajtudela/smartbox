# Copy this file to ".env" and fill in your values so the `smartbox` CLI does
# not need the credentials on every invocation. A real shell environment
# variable always overrides the value set here, and an explicit command-line
# option overrides both.

# Your username/password as used for the mobile app / web app (required).
SMARTBOX_USERNAME=
SMARTBOX_PASSWORD=

# API name for your heater vendor, e.g. "api" or "api-foo" (see README).
SMARTBOX_API_NAME=api

# Only needed if your reseller is not built into the package.
SMARTBOX_BASIC_AUTH_CREDS=
SMARTBOX_X_REFERER=
SMARTBOX_X_SERIAL_ID=
